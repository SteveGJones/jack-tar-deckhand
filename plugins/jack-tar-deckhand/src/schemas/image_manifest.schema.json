{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jack-tar.dev/schemas/image-manifest.json",
  "title": "ImageManifest",
  "description": "Registry of generated image assets with provenance and status.",
  "type": "object",
  "required": ["images"],
  "properties": {
    "generated_at": {"type": "string"},
    "image_backend": {"type": "string"},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_id", "slide_number", "file_path", "status"],
        "properties": {
          "image_id": {"type": "string"},
          "slide_number": {"type": "integer"},
          "file_path": {"type": "string"},
          "placement_zone": {
            "type": "string",
            "description": "Zone the image occupies on the slide. Includes 'full_bleed' (Step 4.7 full-slide images) and element-flow values like 'background', plus the annotate-figure v2 native-annotation values 'annotated_full_slide' and 'annotated_image_zone' (F8) — deliberately distinct vocabularies, no collision with annotations.schema.json's placement_zone."
          },
          "element_id": {"type": "string"},
          "annotations_path": {
            "type": "string",
            "description": "Relative or absolute path to the slide's SlideAnnotations payload (<deck_dir>/annotations/slide-NN-annotations.json), mirroring the creative_vision_manifest_path precedent (imagegen-bridge Step 4.7). Present only for slides using the annotate-figure v2 native/raster annotation flow."
          },
          "detected_positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["element_id", "x", "y", "w", "h", "confidence"],
              "properties": {
                "element_id": {"type": "string"},
                "x": {"type": "number"},
                "y": {"type": "number"},
                "w": {"type": "number"},
                "h": {"type": "number"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {"type": "integer"},
              "height": {"type": "integer"}
            }
          },
          "source_prompt": {"type": "string"},
          "model_used": {"type": "string"},
          "alt_text": {"type": "string"},
          "content_hash": {"type": "string"},
          "cache_key": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["generated", "cached", "placeholder", "failed", "accepted_with_issues"]
          },
          "retry_count": {"type": "integer"},
          "generation_time_seconds": {"type": "number"},
          "review_summary": {"type": "string"},
          "smartart_ref": {
            "type": "string",
            "description": "Links this enrichment image to a SmartArt graphic ID"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_images": {"type": "integer"},
        "generated_count": {"type": "integer"},
        "cached_count": {"type": "integer"},
        "placeholder_count": {"type": "integer"},
        "failed_count": {"type": "integer"},
        "total_generation_seconds": {"type": "number"}
      }
    }
  }
}
